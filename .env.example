# Local development database (Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calculator?schema=public"

# Test database (Docker Compose) — used by automated tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/calculator_test?schema=public"

# Secret used to sign session cookies (JWT, HS256). Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-characters"