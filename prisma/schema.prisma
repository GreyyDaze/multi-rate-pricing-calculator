// Prisma schema — Multi-Rate Pricing Calculator
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  DRAFT
  FINALIZED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  documents    Document[]
}

model Document {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  customer  String
  issueDate DateTime
  status    DocumentStatus @default(DRAFT)

  // Server-computed document totals (cached for reporting)
  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)
  totalTax      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @default(0) @db.Decimal(12, 2)

  lines     LineItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Report queries filter by owner + issue date
  @@index([userId, issueDate])
}

model LineItem {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  description  String
  quantity     Decimal      @db.Decimal(10, 2)
  unitPrice    Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)
  taxPercent   Decimal      @default(0) @db.Decimal(6, 2)

  // Server-computed per-line amounts (persisted at write time)
  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  discountedAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
}